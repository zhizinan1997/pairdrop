# Runtime logs may contain visitor IPs, device names and transfer activity.
deploy/logs/*.log
logs/*.log

# Local patch generation state; the deployed Service Worker version lives in deploy/patch/.
deploy/patch/.cache-revision

# Never commit credentials, keys, tokens or environment files.
.secrets/
*.key
*.pem
*.p12
*.pfx
.env
.env.*

# Local dependencies and editor / OS artifacts.
node_modules/
.DS_Store
Thumbs.db
*.swp

# Python 字节码（patch-pairdrop.py 本地校验产生）
__pycache__/
*.pyc
